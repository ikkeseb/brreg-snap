{
  // Extension source only. Tests (tests/tsconfig.json) and the Node-side
  // config files (tsconfig.node.json) have their own projects, so Node's
  // globals never leak into code that runs in the browser.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["firefox-webext-browser"]
  },
  "include": ["src/**/*"]
}
