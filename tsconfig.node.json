{
  // Build/test tool config files that run in Node, not in the extension.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // vite.config.ts imports scripts/build-graph.mjs; types come from its
    // JSDoc.
    "allowJs": true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
