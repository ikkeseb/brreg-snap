# Normalize text files to LF in every checkout, whatever core.autocrlf
# says: Vite copies the manifests and HTML entries byte for byte, so the
# build inputs must not depend on the machine's line endings.
* text=auto eol=lf
*.png binary
*.woff2 binary
*.zip binary

# Screenshots are listing assets, not build inputs: keep them out of the
# AMO source-review zip (git archive).
docs/screenshots/ export-ignore
